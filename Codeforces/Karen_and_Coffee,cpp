// https://codeforces.com/contest/816/problem/B
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, k, q;
    cin >> n >> k >> q;

    const int MAXT = 200000;

    vector<int> pref(MAXT + 2, 0);

    int l, r;
    for (int i = 0; i < n; i++) {
        cin >> l >> r;

        pref[l]++;
        pref[r + 1]--;
    }
    
    for (int i = 1; i <= MAXT; i++) {
        pref[i] += pref[i - 1];
    }
    
    for (int i = 1; i <= MAXT; i++) {
        pref[i] = pref[i - 1] + (pref[i] >= k);
    }
    
    while (q--) {
        cin >> l >> r;

        cout << pref[r] - pref[l - 1] << '\n';
    }
}

int main() {
    solve();
    return 0;
}